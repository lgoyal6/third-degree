# Provisioned by `vercel integration add upstash/upstash-kv` — run
# `vercel env pull .env.local` to get these locally. Required: map jobs, grill
# sessions, and rate limits all live here. `Redis.fromEnv()` reads the KV_* names.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional — without it the Layer 1 questions, groundedness grading, and the map
# summary all fall back to deterministic output.
ANTHROPIC_API_KEY=

# Optional — raises GitHub API rate limits (60/hr unauthenticated).
GITHUB_TOKEN=

# Optional — enables "Connect GitHub" for private repos. Create an OAuth App at
# https://github.com/settings/developers with the callback set to
# <your-origin>/api/auth/github/callback. Without both values the button is hidden.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
